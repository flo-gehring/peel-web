{
  "private": true,
  "name": "browser-app",
  "version": "0.0.1",
  "dependencies": {
    "@theia/core": "1.73.0",
    "@theia/editor": "1.73.0",
    "@theia/filesystem": "1.73.0",
    "@theia/messages": "1.73.0",
    "@theia/monaco": "1.73.0",
    "@theia/navigator": "1.73.0",
    "@theia/preferences": "1.73.0",
    "@theia/process": "1.73.0",
    "@theia/request": "1.73.0",
    "@theia/search-in-workspace": "1.73.0",
    "@theia/terminal": "1.73.0",
    "@theia/workspace": "1.73.0",
    "peel-ide": "file:../extensions/peel-ide"
  },
  "devDependencies": {
    "@theia/cli": "1.73.0"
  },
  "scripts": {
    "bundle": "theia build --mode development",
    "start": "npm run bundle && theia start --hostname 0.0.0.0 --port 3000",
    "watch": "theia build --watch --mode development"
  },
  "theia": {
    "target": "browser"
  }
}
