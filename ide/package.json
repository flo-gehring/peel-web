{
  "name": "peel-theia",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "browser-app",
    "extensions/peel-ide"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:browser": "npm run -w browser-app bundle",
